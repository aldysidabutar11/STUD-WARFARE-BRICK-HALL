# Salin jadi .env.local (lokal) atau isi di Vercel → Project → Settings → Environment Variables.
# Tanpa kedua nilai Supabase, "Main Bareng" berjalan dalam mode uji lokal (antar-tab di browser yang sama).

# Supabase → tombol Connect (atau Settings → API Keys): Project URL & publishable key sb_publishable_… (kunci anon lama juga bisa).
# Kunci ini memang publik (dipakai di browser). Realtime → Settings → "Allow public access" harus menyala.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opsional — server TURN untuk teman yang selalu gagal tersambung (NAT ketat: jaringan kampus/kantor/sebagian operator seluler).
# Beberapa URL dipisah koma, mis. turn:host:3478?transport=udp,turns:host:443?transport=tcp
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
